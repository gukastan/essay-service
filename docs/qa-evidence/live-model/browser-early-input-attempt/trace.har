            "mimeType": "text/css",
            "text": "/* [project]/src/components/essay/chrome.css [app-client] (css) */\n.site-header {\n  border-bottom: 1px solid var(--line);\n}\n\n.header-inner {\n  justify-content: space-between;\n  align-items: center;\n  gap: var(--s4);\n  max-width: 1200px;\n  min-height: 80px;\n  margin: auto;\n  display: flex;\n}\n\n.wordmark {\n  font-size: var(--text-lg);\n  letter-spacing: -.06em;\n  align-items: center;\n  gap: var(--s2);\n  font-weight: 750;\n  display: flex;\n}\n\n.brand-dot {\n  background: var(--accent);\n  border-radius: 50%;\n  width: 6px;\n  height: 6px;\n}\n\n.header-note {\n  color: var(--muted);\n  font-size: var(--text-sm);\n}\n\n.page-shell {\n  max-width: 1200px;\n  margin: auto;\n}\n\n.intro {\n  padding: var(--s12) 0 var(--s8);\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: var(--s6);\n  display: flex;\n}\n\n.eyebrow {\n  color: var(--accent);\n  font-size: var(--text-xs);\n  margin-bottom: var(--s4);\n  letter-spacing: .03em;\n  font-weight: 650;\n}\n\nh1 {\n  letter-spacing: -.065em;\n  font-size: clamp(32px, 4vw, 48px);\n  font-weight: 650;\n  line-height: 1.28;\n}\n\n.intro-copy {\n  margin-top: var(--s6);\n  color: var(--muted);\n  font-size: var(--text-base);\n}\n\n.intro-aside {\n  gap: var(--s3);\n  color: var(--muted);\n  font-size: var(--text-xs);\n  padding-bottom: var(--s1);\n  white-space: nowrap;\n  align-items: center;\n  display: flex;\n}\n\n.mobile-break {\n  display: none;\n}\n\n.page-footer {\n  justify-content: space-between;\n  gap: var(--s6);\n  padding: var(--s6) 0 var(--s12);\n  color: var(--muted);\n  font-size: var(--text-xs);\n  display: flex;\n}\n\n.page-footer > span {\n  white-space: nowrap;\n}\n\n/* [project]/src/components/essay/panels.css [app-client] (css) */\n.feedback-region:empty {\n  display: none;\n}\n\n.notice {\n  margin-bottom: var(--s6);\n  padding: var(--s4) var(--s6);\n  border-radius: var(--radius-sm);\n  overflow-wrap: anywhere;\n}\n\n.notice span {\n  font-size: var(--text-sm);\n  margin-top: var(--s1);\n  display: block;\n}\n\n.notice.info {\n  color: var(--success);\n  background: var(--success-wash);\n}\n\n.notice.error {\n  color: var(--error);\n  background: var(--error-wash);\n}\n\n.workspace {\n  gap: var(--s6);\n  grid-template-columns: minmax(0, .44fr) minmax(0, .56fr);\n  align-items: start;\n  display: grid;\n}\n\n.panel {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius-md);\n  padding: var(--s6);\n  min-width: 0;\n}\n\n.section-heading {\n  align-items: center;\n  gap: var(--s3);\n  flex-wrap: wrap;\n  display: flex;\n}\n\n.section-heading h2 {\n  font-size: var(--text-heading);\n  letter-spacing: -.045em;\n  font-weight: 650;\n}\n\n.step {\n  color: var(--muted);\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n}\n\n.section-description {\n  margin-top: var(--s2);\n  margin-bottom: var(--s8);\n  color: var(--muted);\n  font-size: var(--text-sm);\n}\n\n.length-badge {\n  color: var(--muted);\n  background: var(--subtle);\n  font-size: var(--text-xs);\n  padding: var(--s1) var(--s2);\n  border-radius: var(--radius-sm);\n  margin-left: auto;\n}\n\n.result-panel {\n  min-height: 720px;\n}\n\n.empty-result {\n  text-align: center;\n  min-height: 548px;\n  padding: var(--s8) var(--s4);\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  display: flex;\n}\n\n.document-mark {\n  color: var(--muted);\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--canvas);\n  letter-spacing: -.07em;\n  width: 64px;\n  height: 80px;\n  margin-bottom: var(--s6);\n  place-items: center;\n  font-size: 28px;\n  display: grid;\n}\n\n.empty-result h3 {\n  font-size: var(--text-lg);\n  margin-bottom: var(--s3);\n  font-weight: 600;\n}\n\n.empty-result p {\n  font-size: var(--text-sm);\n  color: var(--muted);\n  line-height: 1.9;\n}\n\n.empty-rule {\n  background: var(--line);\n  width: 32px;\n  height: 1px;\n  margin: var(--s8) 0 var(--s6);\n}\n\n.empty-result .empty-note {\n  font-size: var(--text-xs);\n}\n\n.source-block {\n  padding: var(--s4);\n  border-radius: var(--radius-sm);\n  background: var(--canvas);\n  margin-bottom: var(--s6);\n}\n\n.source-header {\n  justify-content: space-between;\n  gap: var(--s2);\n  margin-bottom: var(--s3);\n  flex-wrap: wrap;\n  display: flex;\n}\n\n.source-header h3 {\n  font-size: var(--text-xs);\n  font-weight: 650;\n}\n\n.source-header span {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  overflow-wrap: anywhere;\n}\n\n.original-experience {\n  font-size: var(--text-sm);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  word-break: normal;\n}\n\n.draft-heading {\n  justify-content: space-between;\n  gap: var(--s2);\n  flex-wrap: wrap;\n  align-items: baseline;\n  display: flex;\n}\n\n.count {\n  font-size: var(--text-sm);\n  font-variant-numeric: tabular-nums;\n}\n\n.valid {\n  color: var(--success);\n}\n\n.warning {\n  color: var(--warning);\n}\n\n.draft-editor {\n  line-height: 1.9;\n}\n\n.length-guidance {\n  margin-top: var(--s4);\n  padding: var(--s3);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-sm);\n}\n\n.length-guidance.valid {\n  background: var(--success-wash);\n}\n\n.length-guidance.warning {\n  background: var(--warning-wash);\n}\n\n.copy-row {\n  align-items: center;\n  gap: var(--s4);\n  margin-top: var(--s6);\n  display: flex;\n}\n\n.copy-feedback {\n  font-size: var(--text-sm);\n  color: var(--muted);\n  overflow-wrap: anywhere;\n}\n\n/* [project]/src/components/essay/fields.css [app-client] (css) */\n.fields {\n  gap: var(--s6) var(--s4);\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  display: grid;\n}\n\n.field-wide {\n  grid-column: 1 / -1;\n}\n\n.field {\n  min-width: 0;\n}\n\nlabel {\n  font-size: var(--text-sm);\n  margin-bottom: var(--s2);\n  font-weight: 650;\n  display: block;\n}\n\n.required {\n  margin-left: var(--s2);\n  font-size: var(--text-xs);\n  color: var(--muted);\n  font-weight: 400;\n}\n\ninput, textarea {\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--surface);\n  width: 100%;\n  color: var(--ink);\n  padding: var(--s3);\n  font-size: var(--text-base);\n  min-height: var(--s12);\n  line-height: 1.65;\n  display: block;\n}\n\ntextarea {\n  resize: vertical;\n  overflow-wrap: anywhere;\n  word-break: normal;\n}\n\ninput::placeholder, textarea::placeholder {\n  color: var(--muted);\n  opacity: .85;\n}\n\ninput:hover:not(:disabled), textarea:hover:not(:disabled) {\n  background: var(--canvas);\n}\n\n[aria-invalid=\"true\"] {\n  background: var(--error-wash);\n}\n\n.field-hint {\n  margin-top: var(--s2);\n  color: var(--muted);\n  font-size: var(--text-xs);\n  line-height: 1.6;\n}\n\n.field-error {\n  color: var(--error);\n  font-size: var(--text-sm);\n  margin-top: var(--s1);\n}\n\n.button {\n  border-radius: var(--radius-sm);\n  min-height: var(--s12);\n  padding: var(--s3) var(--s6);\n  font-size: var(--text-sm);\n  justify-content: center;\n  align-items: center;\n  gap: var(--s3);\n  border: 1px solid #0000;\n  font-weight: 650;\n  transition: transform .12s ease-out;\n  display: inline-flex;\n}\n\n.button:active:not(:disabled) {\n  transform: scale(.98);\n}\n\n.primary {\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.primary:hover:not(:disabled) {\n  background: var(--accent-hover);\n}\n\n.secondary {\n  background: var(--surface);\n  color: var(--ink);\n  border-color: var(--line);\n  flex-shrink: 0;\n}\n\n.secondary:hover:not(:disabled) {\n  background: var(--subtle);\n}\n\n.generate-button {\n  width: 100%;\n  margin-top: var(--s8);\n}\n\n.generate-button > span:last-child:not(.spinner) {\n  font-size: var(--text-lg);\n  margin-left: auto;\n}\n\n.form-note {\n  color: var(--muted);\n  font-size: var(--text-xs);\n  text-align: center;\n  margin-top: var(--s3);\n}\n\n.spinner {\n  border: 2px solid;\n  border-right-color: #0000;\n  border-radius: 50%;\n  width: 16px;\n  height: 16px;\n  animation: 1s linear infinite spin;\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* [project]/src/app/globals.css [app-client] (css) */\n:root {\n  --lightningcss-light: initial;\n  --lightningcss-dark: ;\n  color-scheme: light dark;\n  --canvas: #f6f5f1;\n  --surface: #fff;\n  --ink: #262b27;\n  --muted: #62685f;\n  --line: #dcded5;\n  --subtle: #efefe9;\n  --accent: #254f3c;\n  --accent-hover: #193c2c;\n  --on-accent: #fff;\n  --success: #295b40;\n  --success-wash: #eaf2eb;\n  --warning: #80551e;\n  --warning-wash: #fbf2df;\n  --error: #9c3830;\n  --error-wash: #f9eeeb;\n  --s1: 4px;\n  --s2: 8px;\n  --s3: 12px;\n  --s4: 16px;\n  --s6: 24px;\n  --s8: 32px;\n  --s12: 48px;\n  --s16: 64px;\n  --text-xs: 12px;\n  --text-sm: 14px;\n  --text-base: 16px;\n  --text-lg: 18px;\n  --text-heading: 22px;\n  --radius-sm: 6px;\n  --radius-md: 12px;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --lightningcss-light: ;\n    --lightningcss-dark: initial;\n  }\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  background: var(--canvas);\n  color: var(--ink);\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, Apple SD Gothic Neo, Malgun Gothic, sans-serif;\n  font-size: var(--text-base);\n  word-break: keep-all;\n  margin: 0;\n  line-height: 1.65;\n}\n\nbutton, input, textarea {\n  font: inherit;\n}\n\nbutton, a, input, textarea {\n  -webkit-tap-highlight-color: transparent;\n}\n\nbutton {\n  cursor: pointer;\n}\n\nbutton:disabled {\n  cursor: wait;\n  opacity: .65;\n}\n\ninput:disabled, textarea:disabled {\n  opacity: .7;\n  cursor: wait;\n}\n\n:focus-visible {\n  outline: 3px solid var(--accent);\n  outline-offset: 3px;\n}\n\nh1, h2, h3, p {\n  margin: 0;\n}\n\nfieldset {\n  border: 0;\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n}\n\n.sr-only {\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  position: absolute;\n  overflow: hidden;\n}\n\n.skip-link {\n  z-index: 10;\n  top: var(--s2);\n  left: var(--s4);\n  padding: var(--s3);\n  background: var(--surface);\n  color: var(--ink);\n  position: absolute;\n  transform: translateY(-180%);\n}\n\n.skip-link:focus {\n  transform: translateY(0);\n}\n\n@media (max-width: 1264px) {\n  .header-inner, .page-shell {\n    margin-inline: var(--s8);\n  }\n}\n\n@media (max-width: 960px) {\n  .workspace {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .intro-aside {\n    display: none;\n  }\n\n  .result-panel {\n    min-height: auto;\n  }\n\n  .empty-result {\n    min-height: 360px;\n  }\n\n  .page-footer {\n    gap: var(--s3);\n    flex-direction: column;\n  }\n}\n\n@media (max-width: 480px) {\n  .header-inner, .page-shell {\n    margin-inline: var(--s4);\n  }\n\n  .header-inner {\n    min-height: 64px;\n  }\n\n  .header-note {\n    font-size: var(--text-xs);\n  }\n\n  .intro {\n    padding-top: var(--s8);\n  }\n\n  .intro-copy {\n    font-size: var(--text-sm);\n  }\n\n  .mobile-break {\n    display: block;\n  }\n\n  .panel {\n    padding: var(--s4);\n  }\n\n  .fields {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .section-heading {\n    gap: var(--s2);\n  }\n\n  .length-badge {\n    font-size: var(--text-xs);\n  }\n\n  .copy-row {\n    align-items: flex-start;\n    gap: var(--s2);\n    flex-direction: column;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .button {\n    transition: none;\n  }\n\n  .button:active:not(:disabled) {\n    transform: none;\n  }\n\n  .spinner {\n    animation: none;\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --canvas: #1e221e;\n    --surface: #272d27;\n    --ink: #eef0e9;\n    --muted: #b5bdb0;\n    --line: #485044;\n    --subtle: #353d33;\n    --accent: #b5d3b7;\n    --accent-hover: #cee4cb;\n    --on-accent: #183020;\n    --success: #c0debe;\n    --success-wash: #304533;\n    --warning: #edce96;\n    --warning-wash: #483d29;\n    --error: #f2b5a9;\n    --error-wash: #48302b;\n  }\n}\n\n/*# sourceMappingURL=src_0w-dmi44hau8i._.css.map*/"
